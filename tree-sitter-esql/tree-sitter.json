{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "esql",
      "camelcase": "ESQL",
      "title": "ESQL",
      "scope": "source.esql",
      "file-types": [
        "esql"
      ],
      "injection-regex": "^esql$",
      "class-name": "TreeSitterEsql"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Elasticsearch ES|QL",
    "authors": [
      {
        "name": "Josh Mock",
        "email": "joshua.mock@elastic.co"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-esql"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}